{
  "attribution": false,
  "autoMemoryEnabled": false,
  "deniedMcpServers": [{ "serverName": "claude.ai Claude Docs" }],
  "theme": "light",
  "env": {
    "GIT_CONFIG_COUNT": "2",
    "GIT_CONFIG_KEY_0": "url.claude-may-not-push:.pushInsteadOf",
    "GIT_CONFIG_KEY_1": "url.claude-may-not-push:.pushInsteadOf",
    "GIT_CONFIG_VALUE_0": "git@",
    "GIT_CONFIG_VALUE_1": "https://"
  },
  "permissions": {
    "allow": [
      "mcp__claude_ai_ClickUp__clickup_download_*",
      "mcp__claude_ai_ClickUp__clickup_filter_*",
      "mcp__claude_ai_ClickUp__clickup_find_*",
      "mcp__claude_ai_ClickUp__clickup_get_*",
      "mcp__claude_ai_ClickUp__clickup_list_*",
      "mcp__claude_ai_ClickUp__clickup_resolve_*",
      "mcp__claude_ai_ClickUp__clickup_search*",
      "mcp__claude_ai_Slack__slack_get_*",
      "mcp__claude_ai_Slack__slack_list_*",
      "mcp__claude_ai_Slack__slack_read_*",
      "mcp__claude_ai_Slack__slack_search_*"
    ],
    "ask": [
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -- *)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git restore:*)",
      "Bash(git stash drop:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ansible/**)",
      "Read(~/.aws/**)",
      "Read(~/.bash_history)",
      "Read(~/.bash_sessions/**)",
      "Read(~/.claude.json)",
      "Read(~/.codex/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/**)",
      "Read(~/.gemini/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.putty/**)",
      "Read(~/.python_history)",
      "Read(~/.ssh/**)",
      "Read(~/.zsh_history)",
      "Read(~/.zsh_sessions/**)",
      "Read(~/Library/Application Support/Firefox/**)",
      "Read(~/Library/Application Support/Google/**)",
      "Read(~/Library/CloudStorage/**)",
      "Read(~/Library/Cookies/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Mail/**)",
      "Read(~/Library/Messages/**)",
      "Read(~/Library/Mobile Documents/**)",
      "Read(~/MEGA/**)",
      "mcp__claude_ai_ClickUp__clickup_add_*",
      "mcp__claude_ai_ClickUp__clickup_attach_*",
      "mcp__claude_ai_ClickUp__clickup_create_*",
      "mcp__claude_ai_ClickUp__clickup_delete_*",
      "mcp__claude_ai_ClickUp__clickup_execute_*",
      "mcp__claude_ai_ClickUp__clickup_merge_*",
      "mcp__claude_ai_ClickUp__clickup_move_*",
      "mcp__claude_ai_ClickUp__clickup_remove_*",
      "mcp__claude_ai_ClickUp__clickup_request_*",
      "mcp__claude_ai_ClickUp__clickup_send_*",
      "mcp__claude_ai_ClickUp__clickup_start_*",
      "mcp__claude_ai_ClickUp__clickup_stop_*",
      "mcp__claude_ai_ClickUp__clickup_update_*",
      "mcp__claude_ai_Slack__slack_add_*",
      "mcp__claude_ai_Slack__slack_complete_*",
      "mcp__claude_ai_Slack__slack_create_*",
      "mcp__claude_ai_Slack__slack_schedule_*",
      "mcp__claude_ai_Slack__slack_send_*",
      "mcp__claude_ai_Slack__slack_update_*"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "allowWrite": ["~/.cache/claude-sandbox"]
    },
    "network": {
      "allowedDomains": [
        "files.pythonhosted.org",
        "github.com",
        "proxy.golang.org",
        "pypi.org"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devenv_directory=\"$CLAUDE_PROJECT_DIR/.devenv\"; readlink \"$devenv_directory/profile\" | grep -q '^/nix/store/' || exit 0; echo \"export PATH=\\\"$devenv_directory/state/go/bin:$devenv_directory/state/venv/bin:$devenv_directory/profile/bin:\\$PATH\\\"\" >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cache_directory=\"$HOME/.cache/claude-sandbox\"; mkdir -p \"$cache_directory\"; echo \"export GOPATH=$cache_directory/go GOCACHE=$cache_directory/go-build PREK_HOME=$cache_directory/prek UV_CACHE_DIR=$cache_directory/uv\" >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ]
  }
}
