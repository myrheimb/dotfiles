{
    "agent_servers": {
        "claude-acp": {
            "type": "registry"
        }
    },
    "buffer_font_features": {
        "calt": false
    },
    "cli_default_open_behavior": "new_window",
    "project_panel": {
        "dock": "left"
    },
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    "git_panel": {
        "dock": "left",
        "tree_view": true
    },
    "edit_predictions": {
        "mode": "subtle"
    },
    "ui_font_size": 15.0,
    "buffer_font_size": 13.0,
    "agent": {
        "dock": "right",
        "enable_feedback": true,
        "enabled": true,
        "button": true,
        "favorite_models": [],
        "model_parameters": []
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "session": {
        "trust_all_worktrees": true
    },
    "use_on_type_format": true,
    "show_whitespaces": "all",
    "show_edit_predictions": false,
    "wrap_guides": [88],
    "icon_theme": "Zed (Default)",
    "base_keymap": "VSCode",
    "theme": {
        "mode": "light",
        "light": "One Light",
        "dark": "One Dark"
    },
    "tab_size": 4,
    "languages": {
        "Markdown": {
            "show_edit_predictions": false
        },
        "CSS": {
            "format_on_save": "off"
        },
        "HTML": {
            "format_on_save": "off"
        },
        "PHP": {
            "format_on_save": "off"
        },
        "Python": {
            "tab_size": 4,
            "language_servers": ["zuban", "!pyright", "!pylsp", "!ty"]
        },
        "Go": {
            "hard_tabs": true
        },
        "Shell Script": {
            "tab_size": 2
        },
        "JSON": {
            "tab_size": 2
        },
        "Nix": {
            "tab_size": 2
        },
        "YAML": {
            "tab_size": 2,
            "format_on_save": "off"
        }
    },
    "lsp": {
        "ruff": {
            "initialization_options": {
                "settings": {
                    "configurationPreference": "filesystemFirst",
                    "configuration": "~/.config/zed/ruff.toml"
                }
            }
        }
    }
}
